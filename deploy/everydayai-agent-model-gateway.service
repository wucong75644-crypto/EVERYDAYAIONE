[Unit]
Description=EVERYDAYAIONE Agent Model Gateway
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=everydayai-agent-model-gateway
Group=everydayai-model-gateway
SupplementaryGroups=everydayai-model-gateway-secret
WorkingDirectory=/var/www/everydayai/backend
Environment="PATH=/var/www/everydayai/backend/venv/bin:/usr/bin:/bin"
Environment="EVERYDAYAI_LOG_DIR=/var/log/everydayai/model-gateway"
EnvironmentFile=/etc/everydayai/agent-model-gateway.env
EnvironmentFile=/etc/everydayai/agent-model-gateway-kek.env
InaccessiblePaths=-/var/www/everydayai/backend/.env -/var/www/everydayai/backend/.env.kek -/etc/everydayai/agent-runtime-worker.env -/etc/everydayai/agent-runtime-model.env
RuntimeDirectory=everydayai-agent-model-gateway
RuntimeDirectoryMode=0750
ExecStart=/var/www/everydayai/backend/venv/bin/python agent_model_gateway_main.py
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=140
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/run/everydayai-agent-model-gateway /var/log/everydayai/model-gateway
UMask=0007

[Install]
WantedBy=multi-user.target
