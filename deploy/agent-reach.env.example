# Reference only: merge selected fields into backend/.env via existing env management.
# Do not source this template into production or replace the application's .env.
AGENT_REACH_ENABLED=false
AGENT_REACH_PLATFORMS=web,github,rss
AGENT_REACH_WRITE_ACTIONS=
AGENT_REACH_BIN_DIR=/opt/everydayai-agent-reach/bin
AGENT_REACH_MEDIA_STAGING_DIR=/var/lib/everydayai/reach-media
AGENT_REACH_TIMEOUT_SECONDS=60
AGENT_REACH_EXA_API_KEY=
AGENT_REACH_YOUTUBE_API_KEY=
AGENT_REACH_GOOGLE_CLIENT_ID=
AGENT_REACH_GOOGLE_CLIENT_SECRET=
# Must exactly match the authorized redirect URI in Google Cloud.
AGENT_REACH_GOOGLE_REDIRECT_URI=
# Organization UUID -> [{connection_id,origin,service_token}]. Each slot is dedicated.
AGENT_REACH_XHS_SLOTS_JSON={}
# Existing connections only; do not duplicate a slot above.
AGENT_REACH_XHS_ORIGINS_JSON={}
# Existing CONFIG_KEK_* settings must already be available to API and actor workers.
# Never copy real service tokens or OAuth secrets into this tracked template.
