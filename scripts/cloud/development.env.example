# Safe defaults. The init command generates a private JWT key in backend/.env.
APP_ENV=development
APP_DEBUG=true
ENVIRONMENT=development
DATABASE_URL=postgresql://everydayai_dev:change-me@127.0.0.1:5432/everydayai_dev
JWT_SECRET_KEY=GENERATED_BY_INIT
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=15
REDIS_SSL=false
CONVERSATION_ACTOR_WEB_ENABLED=false
CONVERSATION_ACTOR_WORKER_ENABLED=false
WECOM_BOT_ENABLED=false
AGENT_REACH_ENABLED=false
SOCIAL_OPS_ENABLED=false
SOCIAL_OPS_SCHEDULED_PUBLISH_ENABLED=false
MEMORY_ENABLED_DEFAULT=false
KB_ENABLED=false
SANDBOX_ENABLED=false
# init sets FILE_WORKSPACE_ROOT to this task's ignored .cloud-dev/workspace directory.
