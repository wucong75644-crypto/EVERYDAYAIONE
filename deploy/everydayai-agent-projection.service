[Unit]
Description=EVERYDAYAIONE Agent Projection Worker
After=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=everydayai-agent-projection
Group=everydayai-app
WorkingDirectory=/var/www/everydayai/backend
Environment="PATH=/var/www/everydayai/backend/venv/bin:/usr/bin:/bin"
Environment="EVERYDAYAI_LOG_DIR=/var/log/everydayai/projection"
EnvironmentFile=/etc/everydayai/agent-projection-worker.env
InaccessiblePaths=-/var/www/everydayai/backend/.env -/var/www/everydayai/backend/.env.kek -/etc/everydayai/agent-runtime-model.env
ExecStartPre=/var/www/everydayai/deploy/runtime-capability-probe.sh projection
ExecStart=/var/www/everydayai/backend/venv/bin/python agent_runtime_worker_main.py
RuntimeDirectory=everydayai-agent-projection
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/everydayai-agent-projection /var/log/everydayai
UMask=0027

[Install]
WantedBy=multi-user.target
