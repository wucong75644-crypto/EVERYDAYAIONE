+	if err := ctx.Err(); err != nil { return nil, err }
+	// The QR browser owns login until its cookies are saved and it closes.
+	// Polling must never launch competing browsers during that session.
+	if s.logins.pending() { return &LoginStatusResponse{IsLoggedIn: false}, nil }
 	b := newBrowser()
 	defer b.Close()
 
