{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product selling points v3 (server-bound evidence aliases)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "product",
    "facts",
    "selling_points",
    "questions",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": "product-selling-points.v3"
    },
    "status": {
      "enum": [
        "ready",
        "needs_input",
        "insufficient"
      ]
    },
    "product": {
      "$ref": "#/$defs/product"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "selling_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sellingPoint"
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "questions": {
            "maxItems": 0
          },
          "selling_points": {
            "minItems": 1,
            "contains": {
              "properties": {
                "priority": {
                  "const": "primary"
                }
              },
              "required": [
                "priority"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          },
          "gaps": {
            "items": {
              "properties": {
                "impact": {
                  "enum": [
                    "limits_claim",
                    "optional"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_input"
          }
        }
      },
      "then": {
        "properties": {
          "questions": {
            "minItems": 1
          },
          "gaps": {
            "contains": {
              "properties": {
                "impact": {
                  "const": "blocks_analysis"
                }
              },
              "required": [
                "impact"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "insufficient"
          }
        }
      },
      "then": {
        "properties": {
          "questions": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "nullableText": {
      "anyOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "use",
        "sale_scope",
        "identity_status",
        "fact_ids"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nullableText"
        },
        "category": {
          "$ref": "#/$defs/nullableText"
        },
        "use": {
          "$ref": "#/$defs/nullableText"
        },
        "sale_scope": {
          "$ref": "#/$defs/nullableText"
        },
        "identity_status": {
          "enum": [
            "clear",
            "provisional",
            "unknown"
          ]
        },
        "fact_ids": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "kind",
        "locator"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "image_observation",
            "image_text",
            "user_statement",
            "document_statement"
          ]
        },
        "locator": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "status",
        "variant_ids",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "enum": [
            "usable",
            "conflicted"
          ]
        },
        "variant_ids": {
          "$ref": "#/$defs/ids"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "sellingPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "buyer_need",
        "buyer_need_basis",
        "scenario",
        "feature",
        "mechanism",
        "benefit",
        "benefit_basis",
        "fact_ids",
        "variant_ids",
        "claim_boundary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "priority": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "buyer_need": {
          "$ref": "#/$defs/nullableText"
        },
        "buyer_need_basis": {
          "enum": [
            "provided",
            "inferred",
            "unknown"
          ]
        },
        "scenario": {
          "$ref": "#/$defs/nullableText"
        },
        "feature": {
          "$ref": "#/$defs/text"
        },
        "mechanism": {
          "$ref": "#/$defs/nullableText"
        },
        "benefit": {
          "$ref": "#/$defs/text"
        },
        "benefit_basis": {
          "enum": [
            "direct",
            "inferred"
          ]
        },
        "fact_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            },
            {
              "minItems": 1
            }
          ]
        },
        "variant_ids": {
          "$ref": "#/$defs/ids"
        },
        "claim_boundary": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "buyer_need_basis": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "buyer_need": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "buyer_need": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "why_needed",
        "gap_ids",
        "options"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "why_needed": {
          "$ref": "#/$defs/text"
        },
        "gap_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            },
            {
              "minItems": 1
            }
          ]
        },
        "options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topic",
        "missing_information",
        "impact",
        "affected_selling_point_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "topic": {
          "$ref": "#/$defs/text"
        },
        "missing_information": {
          "$ref": "#/$defs/text"
        },
        "impact": {
          "enum": [
            "blocks_analysis",
            "limits_claim",
            "optional"
          ]
        },
        "affected_selling_point_ids": {
          "$ref": "#/$defs/ids"
        }
      }
    }
  }
}
